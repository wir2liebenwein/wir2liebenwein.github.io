<!DOCTYPE html>
{#- Grundgerüst jeder Seite. Kopf, Navigation und Fußzeile kommen von hier.
    Übernommen aus dem Webflow-Export; data-wf-page / data-wf-site werden von
    webflow.js für Animationen (Interactions) gebraucht – nicht entfernen. -#}
<html lang="de" data-wf-page="{{ wf_page }}" data-wf-site="5d7915b0f4c0118913297854">
<head>
  <meta charset="utf-8"/>
  <title>{{ title }}</title>
  {%- if description %}
  <meta content="{{ description }}" name="description"/>
  <meta content="{{ description }}" property="og:description"/>
  <meta content="{{ description }}" property="twitter:description"/>
  {%- endif %}
  <meta content="{{ og_title or title }}" property="og:title"/>
  <meta content="{{ og_title or title }}" property="twitter:title"/>
  <meta property="og:type" content="website"/>
  <meta content="summary_large_image" name="twitter:card"/>
  <meta content="width=device-width, initial-scale=1" name="viewport"/>
  <link rel="preload" href="/assets/fonts/oswald-variablefont_wght.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/assets/fonts/sourcesanspro-regular.woff2" as="font" type="font/woff2" crossorigin/>
  <link href="/assets/css/webflow.css" rel="stylesheet" type="text/css"/>
  <link href="/assets/css/eigene-anpassungen.css" rel="stylesheet" type="text/css"/>
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/assets/images/webclip-image-copy.png" rel="shortcut icon" type="image/x-icon"/>
  <link href="/assets/images/webclip-image.png" rel="apple-touch-icon"/>
  <style type="text/css">
  @media screen and (min-width: 1440px) {
    .w-container {
      max-width: 1280px;
    }
  }
  </style>
</head>
<body>
<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
{% include "partials/nav.njk" %}
<main id="inhalt">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/jquery-3.5.1.min.js" type="text/javascript"></script>
<script src="/assets/js/webflow.schunk.36b8fb49256177c8.js" type="text/javascript"></script>
<script src="/assets/js/webflow.schunk.dbaebb87f9cbe218.js" type="text/javascript"></script>
{%- if webflow_bundle == "slider" %}
{#- Neues-Seite: dieses Paket enthält zusätzlich Slider + Lightbox #}
<script src="/assets/js/webflow.19e9a5f9.4f2976e14d91e134.js" type="text/javascript"></script>
{%- else %}
<script src="/assets/js/webflow.1b0b31d5.1ed6268831b181a7.js" type="text/javascript"></script>
{%- endif %}
</body>
</html>
