<!DOCTYPE html>
{#- Grundgerüst jeder Seite. Kopf, Navigation und Fußzeile kommen von hier. -#}
<html lang="de">
<head>
  <meta charset="utf-8"/>
  {#- Seitentitel: "<title> – Wir2LiebenWein". Folgeseiten von /neues/ bekommen "– Seite N".
      Wer einen ganz eigenen Titel braucht (Startseite), setzt titel_komplett. -#}
  {%- if titel_komplett %}{% set seitentitel = titel_komplett %}
  {%- elif pagination and pagination.pageNumber > 0 %}{% set seitentitel = title + " – Seite " + (pagination.pageNumber + 1) + " – " + site.name %}
  {%- else %}{% set seitentitel = title + " – " + site.name %}{% endif %}
  <title>{{ seitentitel }}</title>
  {%- if description %}
  <meta content="{{ description }}" name="description"/>
  <meta content="{{ description }}" property="og:description"/>
  <meta content="{{ description }}" property="twitter:description"/>
  {%- endif %}
  <meta content="{{ seitentitel }}" property="og:title"/>
  <meta content="{{ seitentitel }}" property="twitter:title"/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="{{ site.name }}"/>
  <meta property="og:locale" content="de_DE"/>
  <meta property="og:image" content="{{ site.url }}{{ teilbild or site.teilbild }}"/>
  {%- if page.url.startsWith('/404') %}
  <meta name="robots" content="noindex"/>
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}"/>
  <meta property="og:url" content="{{ site.url }}{{ page.url }}"/>
  {%- endif %}
  <meta content="summary_large_image" name="twitter:card"/>
  <meta content="width=device-width, initial-scale=1" name="viewport"/>
  <link rel="preload" href="/assets/fonts/oswald-variablefont_wght.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/assets/fonts/sourcesanspro-regular.woff2" as="font" type="font/woff2" crossorigin/>
  <link href="/assets/css/site.css" rel="stylesheet"/>
  <link href="/assets/images/webclip-image-copy.png" rel="shortcut icon" type="image/x-icon"/>
  <link href="/assets/images/webclip-image.png" rel="apple-touch-icon"/>
</head>
<body>
<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
{% include "partials/nav.njk" %}
<main id="inhalt">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
