{#- Ein Beitrag auf der Seite "Neues". Erwartet: b = ein Eintrag aus collections.beitraege
    Markup und Klassen 1:1 aus Webflow (damit webflow.css unverändert passt).
    darstellung: einzelbild | lightbox | slider  (siehe docs/WEBSITE.md) -#}
{%- set d = b.data -%}
{%- set gruppe = "beitrag-" + b.fileSlug -%}
<li class="collection-post-entry"><article id="{{ b.fileSlug }}">
<p class="post-tag t-kicker">{{ d.unterzeile }}</p>
<h2 class="post-title t-section">{{ d.titel }}</h2>

{%- if d.darstellung == "slider" %}
<div class="blog-slider w-slider" role="region" aria-roledescription="Bildergalerie" aria-label="{{ d.titel }}">
  <div class="mask w-slider-mask">
    {%- for bild in d.bilder -%}
    <div class="w-slide"><img alt="{{ d.titel }}" sizes="100vw" src="{{ b | bildUrl(bild) }}"{% if not loop.first %} loading="lazy"{% endif %}/></div>
    {%- endfor -%}
  </div>
  <button type="button" class="w-slider-arrow-left" aria-label="Vorheriges Bild"><span class="w-icon-slider-left" aria-hidden="true"></span></button>
  <button type="button" class="w-slider-arrow-right" aria-label="Nächstes Bild"><span class="w-icon-slider-right" aria-hidden="true"></span></button>
  <div class="w-slider-nav w-round"></div>
</div>

{%- elif d.bilder and d.bilder.length %}
<a class="blog-einzelbild inline-block" href="{{ b | bildUrl(d.bilder[0]) }}" data-lightbox="{{ gruppe }}"><img alt="{{ d.titel }}" loading="lazy" sizes="(max-width: 479px) 96vw, (max-width: 767px) 93vw, (max-width: 991px) 92vw, 800px" src="{{ b | bildUrl(d.bilder[0]) }}"/></a>
{%- if d.darstellung == "lightbox" %}
{#- auch bei nur 1 Bild vorhanden: die (leere) Leiste sorgt wie in Webflow für 20px Abstand #}
<div class="blog-lightbox">
  {%- for bild in d.bilder.slice(1, 4) %}
  <a class="lightbox-link inline-block" href="{{ b | bildUrl(bild) }}" data-lightbox="{{ gruppe }}"><img alt="{{ d.titel }}"{% if loop.first %} class="first-image-lightbox"{% endif %} loading="lazy" sizes="100vw" src="{{ b | bildUrl(bild) }}"/></a>
  {%- endfor %}
</div>
{%- endif %}
{%- endif %}

<div class="rich-text-block richtext">{{ b.content | safe }}</div>
<div class="text-arrow-combo">
  {%- if d.zusatzlink %}
  <div class="link richtext">{{ d.zusatzlink | markdown | safe }}</div><img alt="" class="arrow-back" src="/assets/images/internal-link-arrow.svg"/>
  {%- endif %}
  <div class="spacer-div-25px"></div>
</div>
<div class="link-bottom-leiste">
  <div class="blog-div-links"><a class="post-link-contact inline-block" href="/bestell-kontakt"><div class="link-zu-winzer-weinen">Unsere Kontaktdaten</div><div class="link-icon" aria-hidden="true">a</div></a></div>
  <div class="post-links-right"><a class="post-link-sortiment inline-block" href="/sortiment"><div class="link-zu-winzer-weinen">Unser Sortiment</div><div class="link-icon" aria-hidden="true">C</div></a></div>
</div>
</article></li>
